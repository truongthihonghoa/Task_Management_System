# ============================================================
# Database Configuration
# ============================================================
# Option A: Full connection URL (recommended for Supabase/Neon/Render)
DATABASE_URL=postgresql://postgres:password@your-db-public-host.example.com:5432/task_management_db

# Supabase pooler example (URL-encode special chars in password, e.g. @ → %40):
# DATABASE_URL=postgresql://postgres.project-ref:your-url-encoded-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Option B: Individual fields (raw password — no URL encoding needed)
DB_NAME=task_management_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=your-db-public-host.example.com
DB_PORT=5432

# Supabase DB_* example:
# DB_NAME=postgres
# DB_USER=postgres.project-ref
# DB_PASSWORD=your-raw-password-can-contain-@
# DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
# DB_PORT=5432

# ============================================================
# JWT / Token Configuration
# ============================================================
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Account Security
# ============================================================
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ============================================================
# SMTP / Email Configuration
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-google-app-password

EMAIL_FROM=your-gmail@gmail.com
EMAIL_FROM_NAME=TaskFlow
SMTP_USE_TLS=true

OTP_EXPIRE_MINUTES=15

# ============================================================
# Application
# ============================================================
APP_NAME=TaskFlow
FRONTEND_URL=https://your-frontend-public-url.example.com
BACKEND_PUBLIC_URL=https://your-backend-public-url.example.com
