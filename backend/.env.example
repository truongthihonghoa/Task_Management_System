# Database Configuration
# Replace this with the public database URL from Supabase, Neon, Render, or Railway.
DATABASE_URL=postgresql://postgres:password@your-db-public-host.example.com:5432/task_management_db

# Public app URLs after deploying to cloud.
FRONTEND_URL=https://your-frontend-public-url.example.com
BACKEND_PUBLIC_URL=https://your-backend-public-url.example.com

# Supabase pooler example. Replace placeholders in your local .env only.
# If your password contains special characters like @, prefer the DB_* fields below.
# DATABASE_URL=postgresql://postgres.project-ref:your-url-encoded-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Or configure each part separately.
DB_NAME=task_management_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=your-db-public-host.example.com
DB_PORT=5432

# Supabase DB_* example for local .env:
# DB_NAME=postgres
# DB_USER=postgres.project-ref
# DB_PASSWORD=your-raw-password-can-contain-@
# DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
# DB_PORT=5432
