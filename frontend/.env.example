# Public backend API URL used by the frontend build.
# Replace this with your backend cloud URL, for example:
# VITE_API_URL=https://taskflow-api.onrender.com
VITE_API_URL=https://your-backend-public-url.example.com

# Optional public frontend URL assigned by your cloud provider.
# Example: https://taskflow-frontend.up.railway.app
VITE_APP_URL=https://your-frontend-public-url.example.com
